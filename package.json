{
  "name": "whatsapp-music-bot",
  "version": "0.1.0",
  "description": "Bot de WhatsApp para buscar, convertir y enviar música desde el chat",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "dotenv": "^18.0.9",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
