# Prefijo de los comandos (ej: !play, /play)
PREFIX=!

# Nombre que muestra el bot en los mensajes de ayuda
BOT_NAME=MusicBot

# Carpetas de sesión de WhatsApp, base de datos y temporales
AUTH_DIR=./auth
DATA_DIR=./data
TMP_DIR=./tmp

# Duración máxima de una canción en segundos (10 min por defecto)
MAX_DURATION_SECONDS=600

# Segundos de espera entre descargas por usuario
COOLDOWN_SECONDS=15

# true = enviar como nota de voz, false = enviar como archivo de audio
SEND_AS_VOICE_NOTE=false

# Bitrate del audio Opus (WhatsApp funciona bien con 64k–128k)
AUDIO_BITRATE=96k

# Ruta a los binarios (por defecto se buscan en el PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Nivel de logs: trace, debug, info, warn, error
LOG_LEVEL=info

# Si usas emparejamiento por código en vez de QR, pon tu número con código de país (sin +)
PAIRING_NUMBER=
